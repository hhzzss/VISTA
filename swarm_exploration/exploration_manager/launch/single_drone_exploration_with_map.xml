<launch>
  <!-- Map selection: pillar.pcd, office.pcd, office2.pcd, office3.pcd -->
  <arg name="map_name" default="pillar.pcd"/>
  <arg name="drone_id" default="1"/>
  <arg name="drone_num" default="1"/>
  <arg name="init_x" default="0"/>
  <arg name="init_y" default="0"/>
  <arg name="init_z" default="1"/>
  <arg name="map_size_x" default="35.0"/>
  <arg name="map_size_y" default="35.0"/>
  <arg name="map_size_z" default="3.5"/>

  <!-- Publish map -->
  <node pkg="map_generator" name="map_pub" type="map_pub" output="screen"
        args="$(find map_generator)/resource/$(arg map_name)">
  </node>

  <!-- Single drone exploration -->
  <include file="$(find exploration_manager)/launch/single_drone_exploration.xml">
    <arg name="drone_id" value="$(arg drone_id)"/>
    <arg name="drone_num" value="$(arg drone_num)"/>
    <arg name="init_x" value="$(arg init_x)"/>
    <arg name="init_y" value="$(arg init_y)"/>
    <arg name="init_z" value="$(arg init_z)"/>
    <arg name="map_size_x" value="$(arg map_size_x)"/>
    <arg name="map_size_y" value="$(arg map_size_y)"/>
    <arg name="map_size_z" value="$(arg map_size_z)"/>
    <arg name="simulation" value="true"/>
  </include>

  <!-- RViz -->
  <include file="$(find exploration_manager)/launch/rviz.launch"/>
</launch>
